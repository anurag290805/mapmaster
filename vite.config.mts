import { createHash } from "node:crypto";
import { cpSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { defineConfig } from "vitest/config";

const PUBLIC_BETA_BLOCKED_SVGS = [
  "australia.svg",
  "brazil.svg",
  "canada.svg",
  "china.svg",
  "germany.svg",
  "japan.svg",
  "spain.svg",
  "uae.svg",
  "usa.svg",
  "world.svg",
];
const CLASSIC_RUNTIME_FILES = [
  "data.js",
  "state.js",
  "audio.js",
  "ui.js",
  "modes.js",
  "game.js",
  "events.js",
  "navigation-core.js",
  "navigation.js",
  "progress.js",
];

function createOfflineWorker(precache: string[], cacheVersion: string) {
  return `/* Generated by vite.config.mts: cache only approved app-shell files. */
const CACHE_NAME = "mapmaster-shell-${cacheVersion}";
const PRECACHE = ${JSON.stringify(precache)};
const INDEX_URL = new URL("./index.html", self.registration.scope).href;

self.addEventListener("install", (event) => {
  event.waitUntil(caches.open(CACHE_NAME).then((cache) => cache.addAll(PRECACHE)).then(() => self.skipWaiting()));
});
self.addEventListener("activate", (event) => {
  event.waitUntil(caches.keys().then((keys) => Promise.all(keys.filter((key) => key.startsWith("mapmaster-shell-") && key !== CACHE_NAME).map((key) => caches.delete(key)))).then(() => self.clients.claim()));
});
self.addEventListener("fetch", (event) => {
  const request = event.request;
  if (request.method !== "GET" || new URL(request.url).origin !== self.location.origin) return;
  if (request.mode === "navigate") {
    event.respondWith(fetch(request).catch(() => caches.match(INDEX_URL)));
    return;
  }
  // CacheStorage contains only the generated allowlist above. Matching it
  // directly avoids any runtime caching while also keeping relative root and
  // subpath asset URLs stable across static hosts.
  event.respondWith(caches.match(request, { ignoreSearch: true, ignoreVary: true }).then((cached) => cached || fetch(request)));
});
`;
}

// Classic scripts depend on shared global lexical bindings and must remain ordered.
export default defineConfig(({ mode }) => {
  if (mode === "public-beta") {
    throw new Error(
      `CP05 public-beta build blocked: unresolved redistribution rights for ${PUBLIC_BETA_BLOCKED_SVGS.join(", ")}.`,
    );
  }

  return {
    base: "./",
    publicDir: false,
    build: { sourcemap: false },
    plugins: [
      {
        name: "copy-classic-runtime",
        writeBundle(outputOptions, bundle) {
          const outputDir = outputOptions.dir ?? resolve("dist");
          mkdirSync(resolve(outputDir, "js"), { recursive: true });
          for (const file of CLASSIC_RUNTIME_FILES) {
            cpSync(resolve("js", file), resolve(outputDir, "js", file));
          }
          for (const dir of ["svg", "assets"]) {
            cpSync(resolve(dir), resolve(outputDir, dir), {
              recursive: true,
              filter: (source) =>
                !source.endsWith(".DS_Store") &&
                (source === resolve(dir) || !source.endsWith("/svg/svg")),
            });
          }
          // Only Vite's JS/CSS shell, the pre-approved India map used by the
          // existing root app, and ordered classic runtime are eligible here.
          // In particular, do not precache dist/svg: it includes CP05 assets
          // whose public-beta redistribution gate remains unresolved.
          const bundledShell = Object.keys(bundle).filter(
            (file) =>
              file === "index.html" ||
              /^assets\/(?:.+\.(?:js|css)|icon-.+\.svg|india-.+\.svg)$/.test(
                file,
              ),
          );
          const precache = [
            "./",
            "./index.html",
            ...bundledShell.map((file) => `./${file}`),
            ...CLASSIC_RUNTIME_FILES.map((file) => `./js/${file}`),
          ];
          const cacheVersion = createHash("sha256")
            .update(
              [...new Set(precache)]
                .map((entry) => {
                  const file = entry === "./" ? "index.html" : entry.slice(2);
                  return `${entry}:${readFileSync(resolve(outputDir, file))}`;
                })
                .join("\n"),
            )
            .digest("hex")
            .slice(0, 12);
          writeFileSync(
            resolve(outputDir, "service-worker.js"),
            createOfflineWorker([...new Set(precache)], cacheVersion),
          );
        },
      },
    ],
    test: { include: ["tests/unit/**/*.test.ts"] },
  };
});
